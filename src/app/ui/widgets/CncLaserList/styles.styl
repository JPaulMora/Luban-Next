@import '../../../styles/global-var.styl';

// Width and max-height are set inline by ObjectListBox (resizable, default 264 x 176).
.object-list-resizable {
    position: relative;
}

.object-list-resize-top {
    position: absolute;
    top: 0;
    left: 0;
    right: 12px;
    height: 6px;
    z-index: 1;
    cursor: ns-resize;

    &:hover {
        background-color: $blue-5;
    }
}

.object-list-resize-corner {
    position: absolute;
    top: 0;
    right: 0;
    width: 12px;
    height: 12px;
    z-index: 1;
    cursor: nesw-resize;
    background: linear-gradient(45deg, transparent 50%, $grey-1 50%);

    &:hover {
        background: linear-gradient(45deg, transparent 50%, $blue-3 50%);
    }
}

// The Toolpath List uses this max-height. The Object List overrides it inline.
.object-list-box {
    max-height: 176px;
    overflow-y: auto;
    //margin: 4px 0;
    //padding-top: 4px;
}

.tool-change-row {
    margin: 4px 8px;
    padding: 6px 8px;
    border: 1px dashed #B9BCBF;
    border-radius: 4px;
    background: #F7F8F9;
    gap: 8px;
}

.tool-change-copy {
    min-width: 0;
}

.tool-change-title {
    font-size: 12px;
    font-weight: 600;
    color: #2A2C2E;
    line-height: 16px;
}

.tool-change-tools {
    font-size: 11px;
    color: #85888C;
    line-height: 14px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.tool-change-warning {
    font-size: 11px;
    color: #D94F00;
    line-height: 14px;
    margin-top: 2px;
}

.tool-change-offset {
    flex-shrink: 0;
    gap: 4px;
}

.tool-change-offset-label {
    font-size: 11px;
    color: #575859;
    white-space: nowrap;
}

.tool-change-offset :global(.ant-input-number) {
    width: 64px;
}

.object-list-item {
    padding: 4px 0;

    &.selected {
        background-color: $background-color-selected;
    }

    &:not(.selected):hover {
        background-color: #EEEFF0;
    }

    .process {
        padding: 0 12px;
    }

    .toolpath-main {
        min-height: 24px;
    }

    .toolpath-labels {
        min-width: 0;
        display: inline-block;
        vertical-align: middle;
        line-height: 14px;
    }

    .prefix-name {
        display: inline-block
        vertical-align: middle
        max-width: 85%;
        overflow: hidden
        white-space: nowrap
        text-overflow: ellipsis
    }

    .suffix-name {
        display: inline-block
        vertical-align: middle
    }

    .tool-name {
        display: block;
        font-size: 11px;
        color: #85888C;
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
        max-width: 180px;
    }

    .icon {
        box-sizing: content-box;
        display: inline-block;
        width: 24px;
        height: 24px;
        vertical-align: middle;
        margin: 0 4px;
    }

    .icon-shape {
        background: url("images/list_ic_shape_18x18@2x.png") no-repeat center center
        display: inline-block
    }

    .icon-pic {
        background: url("images/list_ic_pic_18x18@2x.png") no-repeat center center
        display: inline-block
    }

    .icon-text {
        background: url("images/list_ic_text_18x18@2x.png") no-repeat center center
        display: inline-block
    }

    .icon-check {
        background: url("images/ic_box_check_14x14.png") no-repeat center center
        background-size: 18px
        display: inline-block
    }

    .icon-uncheck {
        background: url("images/ic_box_uncheck_14x14.png") no-repeat center center
        background-size: 18px
        display: inline-block
    }

    .icon-running {
        background: url("images/list_ic_running_18x18@2x.png") no-repeat center center
        background-size: 18px
        display: inline-block
    }

    .icon-warning {
        background: url("images/list_ic_warning_18x18@2x.png") no-repeat center center
        background-size: 18px
        display: inline-block
    }

    .icon-error {
        background: url("images/list_ic_error_18x18@2x.png") no-repeat center center
        background-size: 18px
        display: inline-block
    }
}
