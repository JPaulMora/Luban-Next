# Set the default behavior
* text=auto

# Media stays binary. text=auto would rewrite bytes inside GIF and MP4.
*.gif binary
*.mp4 binary
*.mov binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary

# Always convert line endings to LF on checkout
*.css   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.sh    text eol=lf
*.json  text eol=lf
